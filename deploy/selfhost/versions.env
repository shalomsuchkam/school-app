# Pinned versions of everything bootstrap.sh downloads. Reviewed in git, not configured on the server.
#
# Official self-hosted Supabase (https://github.com/supabase/supabase/tree/<commit>/docker).
# bootstrap.sh fetches exactly SUPABASE_DOCKER_COMMIT and, when SUPABASE_DOCKER_REF is set, refuses to run
# unless that tag still points at the same commit. The upstream compose file pins every image version,
# so this one commit pins the whole stack.
#
# TO FILL BEFORE THE FIRST RUN (engineer): pick a docker release tag that is at least 14 days old,
# see https://github.com/supabase/supabase/blob/master/docker/CHANGELOG.md and the repository tags, then
#   git ls-remote https://github.com/supabase/supabase.git 'refs/tags/<tag>^{}' 'refs/tags/<tag>'
# and paste the tag and the commit (the ^{} line when present) below. Upgrading = change both + bootstrap.sh --upgrade.
SUPABASE_DOCKER_REF=CHANGE_ME_release_tag
SUPABASE_DOCKER_COMMIT=CHANGE_ME_40_hex_commit_sha

# Client image used only by migrate.sh to read the cloud project (pg_dump must be >= the cloud Postgres major).
PG_CLIENT_IMAGE=postgres:17.6-alpine
