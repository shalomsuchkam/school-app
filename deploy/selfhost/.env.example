# =====================================================================================
# Uroki self-hosted backend — settings template. NO REAL SECRETS IN THIS FILE OR IN GIT.
#
#   Section A -> /opt/uroki/config.env   (non-secret; bootstrap.sh also writes API_DOMAIN/ACME_EMAIL/APP_MODE there)
#   Section B -> generated automatically into /opt/uroki/secrets.env (chmod 600) — do not fill by hand
#   Section C -> /opt/uroki/migrate.env  (chmod 600) only for the migration day; delete it afterwards
# =====================================================================================

# ---------- A. Server settings (/opt/uroki/config.env) ----------
# Public name of the API. DNS: an A record to the VPS IPv4. No AAAA record (IPv6 is not published).
API_DOMAIN=api.example.kz
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=ops@example.kz
# What https://API_DOMAIN/functions/v1/app serves:
#   maintenance = 503 "technical works" (default on a fresh server)
#   local       = the self-hosted edge function + database (after migration)
#   cloud       = reverse proxy to the old Supabase Cloud function (optional transition phase, see README)
APP_MODE=maintenance
# Old cloud host for APP_MODE=cloud
CLOUD_FN_HOST=cmranrfjvvmhktntbnpg.supabase.co
# SSH port kept open in ufw (must match sshd)
SSH_PORT=22
SWAP_SIZE=4G

# Backups (backup.sh, nightly). BACKUP_REMOTE is an rclone remote configured in /root/.config/rclone/rclone.conf,
# ideally a "crypt" remote over ps.kz Object Storage (S3) or a second VPS in another KZ data centre. Empty = local only.
BACKUP_DIR=/var/backups/uroki
BACKUP_KEEP_DAYS=7
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30
# Dead-man switch URLs (e.g. healthchecks.io); optional
BACKUP_PING_URL=
HEALTHCHECK_PING_URL=
# Owner alerts in Telegram (a separate bot; messages contain no personal data); optional
ALERT_TG_BOT_TOKEN=
ALERT_TG_CHAT_ID=

# ---------- B. Generated by bootstrap.sh into /opt/uroki/secrets.env — DO NOT FILL ----------
# POSTGRES_PASSWORD=<generated>
# JWT_SECRET=<generated>
# ANON_KEY=<generated JWT, role=anon>
# SERVICE_ROLE_KEY=<generated JWT, role=service_role>
# DASHBOARD_PASSWORD=<generated>   (Studio login user: uroki-admin, via SSH tunnel only)
# SECRET_KEY_BASE / VAULT_ENC_KEY / PG_META_CRYPTO_KEY / LOGFLARE_* / POOLER_TENANT_ID=<generated>

# ---------- C. Migration only (/opt/uroki/migrate.env, chmod 600, delete after cutover) ----------
# Cloud DB, Session pooler string from Supabase Dashboard -> Connect (IPv4). Use the postgres password.
SRC_DB_URL=postgresql://postgres.cmranrfjvvmhktntbnpg:<DB_PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SRC_SUPABASE_URL=https://cmranrfjvvmhktntbnpg.supabase.co
# Dashboard -> Project Settings -> API keys -> service_role (secret). Used only to download app-photos objects.
SRC_SERVICE_ROLE_KEY=<cloud service_role key>
# Where the new server's pg_cron calls the function (internal, bypasses TLS/Caddy)
CRON_FN_URL=http://kong:8000/functions/v1/app
# Optional, used by "migrate.sh cloud-freeze": oldest app build still allowed on the cloud (forces old apps to update)
CLOUD_MIN_BUILD=
