# «Уроки» lite gateway. Env (docker-compose.yml): API_DOMAIN, SITE_DOMAIN, ACME_EMAIL, APP_MODE (local | maintenance).
# Switch modes with the `maintenance-on` / `maintenance-off` actions (or: sudo /opt/uroki/kit/mode.sh local|maintenance).
# Optional Let's Encrypt e-mail: ACME_EMAIL_ON=on only when ACME_EMAIL is set (an empty `email` is a parse error).
(acme-email-) {
}

(acme-email-on) {
	email {$ACME_EMAIL}
}

{
	import acme-email-{$ACME_EMAIL_ON}
	servers {
		# ufw opens 443/tcp only: no HTTP/3
		protocols h1 h2
	}
}

# The function rate-limits by cf-connecting-ip / x-real-ip (lib.ts clientIp): overwrite both with the real peer,
# so a client cannot spoof its address.
(app-local) {
	reverse_proxy functions:8000 {
		header_up Cf-Connecting-Ip {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

(app-maintenance) {
	header Content-Type "application/json; charset=utf-8"
	header Retry-After 600
	respond `{"error":"Идут технические работы. Попробуйте через несколько минут."}` 503
}

{$API_DOMAIN} {
	encode zstd gzip
	header -Server

	log {
		output stdout
		format json
	}

	route {
		@app path /functions/v1/app /functions/v1/app/*
		handle @app {
			import app-{$APP_MODE:maintenance}
		}

		# Short-lived signed photo/voice links issued by the function (createSignedUrls, 15 min): public.
		@signed path /storage/v1/object/sign/app-photos/*
		handle @signed {
			uri strip_prefix /storage/v1
			reverse_proxy storage:5000
		}

		# REST and Storage for the function itself (it calls SUPABASE_URL=https://API_DOMAIN from inside docker).
		# Never reachable from the internet.
		@rest {
			path /rest/v1/*
			remote_ip private_ranges
		}
		handle @rest {
			uri strip_prefix /rest/v1
			reverse_proxy rest:3000
		}

		@storage {
			path /storage/v1/*
			remote_ip private_ranges
		}
		handle @storage {
			uri strip_prefix /storage/v1
			reverse_proxy storage:5000
		}

		handle {
			header Content-Type "application/json; charset=utf-8"
			respond `{"error":"not found"}` 404
		}
	}
}

# ---------------------------------------------------------------------------------------------------------------
# Public website https://SITE_DOMAIN (urokiapp.kz): static pages from deploy/lite/site, synced by lib.sh sync_site to
# /opt/uroki/site (mounted at /srv/site). The store listings link here: /, /support, /privacy, /terms, /delete-account.
# Certificates for SITE_DOMAIN and www.SITE_DOMAIN are issued automatically (both A records point to this server).
# Independent of APP_MODE: the website stays up during maintenance.
(site-headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		X-Frame-Options DENY
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	import site-headers

	log {
		output stdout
		format json
	}

	route {
		# Legal pages are rendered by the function (supabase/functions/app/legal.ts, ?lang=ru|kk|en, else
		# Accept-Language). Proxied instead of redirected, so the store URL stays https://urokiapp.kz/privacy and the
		# page's relative links (privacy?lang=…, ?lang=kk) keep working. Served in both APP_MODEs.
		@legal path /privacy /terms
		handle @legal {
			rewrite * /functions/v1/app/legal{path}?{query}
			header Vary Accept-Language
			import app-local
		}
		# one address per page: /support/ -> /support (canonical links have no trailing slash)
		@slash path_regexp slash ^(/.+)/$
		redir @slash {re.slash.1}{?query} 301

		handle {
			root * /srv/site
			# no inline scripts or styles on these pages: a strict policy costs nothing
			header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=604800"
			@pages not path /assets/*
			header @pages Cache-Control "public, max-age=600"
			try_files {path} {path}.html {path}/index.html
			file_server
		}
	}

	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}

www.{$SITE_DOMAIN} {
	import site-headers
	redir https://{$SITE_DOMAIN}{uri} permanent
}
