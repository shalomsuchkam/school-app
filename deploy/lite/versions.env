# Pinned images of the lite stack (tag for humans, digest is what docker actually pulls).
# Every digest was checked on Docker Hub; each tag was published at least 14 days before it was pinned (2026-10-22).
# Upgrade = change a line here (new tag + its digest, again >= 14 days old), push, run the `deploy` action
# (it pulls and recreates only changed containers). Postgres major upgrades need a dump/restore, see README.

# Supabase Postgres 17 (same image the official self-hosted compose uses): has the anon/authenticated/service_role/
# authenticator/supabase_storage_admin roles, pg_cron and pg_net preloaded. Published 2026-06-15.
DB_IMAGE=supabase/postgres:17.6.1.136@sha256:f371b5f3f2ac0a05703f33d6e6134515fb2498cab708fb948a0aeb7481467c00

# PostgREST version of the official self-hosted compose (docker/docker-compose.yml, Oct 2026). Published 2026-09-12.
REST_IMAGE=postgrest/postgrest:v14.18@sha256:c7cd7e265a85b05248abf53f4473fcec7e327c282d0bd0cf60f1551996d09fcf

# Supabase Storage API (file backend). Published 2026-10-07.
STORAGE_IMAGE=supabase/storage-api:v1.79.38@sha256:7903ad62951b6b7978fabed4c5db26d10da7c4fea10ee9b4fdfff86440f8b206

# Plain Deno runs the `app` function (see README: lighter than supabase/edge-runtime). Published 2026-09-17.
DENO_IMAGE=denoland/deno:alpine-2.9.7@sha256:8ce780168429c4bf5962652e6cbea3fd45254ae902069e90585fb33f74c56968

# Caddy (automatic HTTPS). Published 2026-10-04.
CADDY_IMAGE=caddy:2.11.6-alpine@sha256:d44355d3c2149dc580ce2cac735955d1c08d3d00882c30489c241aa51a5c10d9

# Postgres 17 client used on the GitHub runner by `migrate-from-cloud` (pg_dump must be >= the cloud major).
PG_CLIENT_IMAGE=postgres:17.10-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
